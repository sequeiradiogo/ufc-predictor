# Virtual environments
.venv/
venv/
env/


# Logs
logs/

# SQLite temp files
*.db-shm
*.db-wal

# Intermediate generated data (regenerate with ml/ML_data_preparation_v1.py)
ml/*.csv

# Databases -- regenerate with db/rebuild_ufcstats_db.py or scripts/scrape_history.py
db/*.db
db/*_backup_*.db

# Trained model artifacts -- distributed via the data-artifacts-latest GitHub Release
# (models_v1.tar.gz / models_v1_prod.tar.gz), not tracked in git.
# See README "Setup" for the download step.
models_v1/*.joblib
models_v1_prod/*.joblib

# Raw source CSVs -- seed CSVs are tracked, others are not
raw_data/*.csv
!raw_data/ufc-master.csv
!raw_data/ufcstats_fighters.csv
!raw_data/ufcstats_fights.csv
!raw_data/ufcstats_fight_stats.csv
!raw_data/espn_dwcs_fights.csv
!raw_data/espn_fighter_map.csv
!raw_data/espn_career_fights.csv
# needed at inference (mma_elo / opponent quality replay it), so tracked like the others
!raw_data/espn_opponent_bouts.csv
# ESPN response cache (scripts/scrape_espn_careers.py) -- resumable, never committed
raw_data/espn_cache/

